{
  "name": "ledgerline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "description": "LedgerLine \u2014 multi-tenant small business accounting SaaS (invoicing, banking, payroll, reports, open API).",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:api && npm run build:web",
    "build:api": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "start": "node dist/server.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc -p tsconfig.json --noEmit",
    "openapi": "tsx scripts/generate-openapi.ts",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "schema:bundle": "node scripts/bundle-migrations.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:vercel:fn": "node scripts/build-vercel.mjs --functions-only"
  }
}
