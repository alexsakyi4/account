# ---------------------------------------------------------------------------
# LedgerLine configuration. Copy to .env and adjust for your environment.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=*

# SQLite for local development (default). Use PostgreSQL in production:
# DATABASE_URL=postgres://ledgerline:password@localhost:5432/ledgerline
DATABASE_URL=sqlite:./data/ledgerline.db
# Managed providers use a private CA, so sslmode=require is treated as
# encrypted-but-unverified (see poolConfig in server/src/db/driver.ts).
# Set PG_SSL_VERIFY_STRICT=true and pass sslrootcert=... to verify the chain.
# PG_SSL_VERIFY_STRICT=false
# PG_POOL_MAX=10

# Serverless bootstrap (Vercel/Netlify/Lambda). Adds a stack trace to the 503
# returned while the function cannot boot — turn off after diagnosing.
# BOOTSTRAP_DEBUG=false
# CRON_SECRET=                 # shared secret for /api/v1/cron/jobs
# SEED_DEMO=false              # seed the sandbox company when the DB is empty

# Secrets — REQUIRED in production (>= 32 chars). Generate with:
#   openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REQUIRE_2FA_FOR_ADMINS=false

# Storage for receipts and attachments. Files are served only through the
# authenticated /attachments/:id route, never as a public directory.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
# STORAGE_DRIVER=local            # local | s3 (the S3 adapter is a stub: implement it
#                                 # in server/src/services/storage.ts before enabling)

# Payments (PCI scope minimisation: card data never touches this server)
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Bank feeds
PLAID_CLIENT_ID=
PLAID_SECRET=

# Receipt OCR: local (text extraction) or http (external engine)
OCR_PROVIDER=local
OCR_ENDPOINT=
OCR_API_KEY=

# Transactional email relay (HTTP endpoint) — otherwise messages are captured
SMTP_URL=

# Demo data
SEED_DEMO=true
ADMIN_EMAIL=admin@ledgerline.app
ADMIN_PASSWORD=ChangeMe123!
DEMO_EMAIL=demo@ledgerline.app
DEMO_PASSWORD=DemoPass123!

# Background worker: runs inside the API by default. Set WORKER_MODE=off to disable
# it in a web replica, or standalone when running a dedicated worker Deployment.
# WORKER_MODE=standalone
JOBS_INTERVAL_MS=15000
LOG_LEVEL=info
